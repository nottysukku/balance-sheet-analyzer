{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    }
  }
}
