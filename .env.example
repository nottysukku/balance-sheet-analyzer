# ---- Server ----
# The API port. API_PORT is preferred over PORT because PORT is often already
# set in the environment by a dev wrapper or container, which would otherwise
# collide with the Vite dev server. The npm dev script passes --port 5174
# explicitly, which beats both.
API_PORT=5174

# Max upload size in megabytes (default 15)
MAX_UPLOAD_MB=15

# ---- Optional: Claude-assisted extraction & narrative ----
# The app is fully functional WITHOUT this key: it falls back to the
# deterministic parser + rule-based insight engine.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
